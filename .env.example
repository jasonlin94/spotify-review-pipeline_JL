# Copy this file to .env and fill in ONLY the keys you actually use.
# .env is gitignored. NEVER commit real keys.

# --- Anthropic (used for classification=Haiku, hard cases + memo=Sonnet) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (free tier via Google AI Studio; key starts with AIza...) ---
GEMINI_API_KEY=

# --- Optional alternatives (leave blank if unused) ---
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# --- Database (dashboard backend). Local dev can use sqlite; prod uses Postgres. ---
DATABASE_URL=

# --- Pipeline safety controls (see cost/COST_CALCULATOR notes) ---
SPEND_LIMIT_USD=25
MAX_WORKERS=1
OUTPUT_TOKEN_CAP=1024
FALLBACK_FRACTION=0.05
